# Copy to .env and fill in real values. NEVER commit .env.

# ─── App ───────────────────────────────────────────────────────────
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080
HTTP_PUBLISH_PORT=8080
# UI timestamps (storage stays UTC). Default Europe/Berlin; falls back to TZ if set.
# DISPLAY_TZ=Europe/Berlin

# Database: sqlite (default, local binary) or mysql (docker-compose)
DB_DRIVER=sqlite

# SQLite (when DB_DRIVER=sqlite)
DATABASE_PATH=./data/m365backup.db

# MySQL (when DB_DRIVER=mysql) — used by docker-compose and bare-metal
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=m365backup
MYSQL_PASSWORD=
MYSQL_DATABASE=m365backup
MYSQL_ROOT_PASSWORD=
# Optional full DSN instead of discrete vars:
# MYSQL_DSN=m365backup:password@tcp(mysql:3306)/m365backup?parseTime=true&loc=UTC

# Snapshot + staging paths (also used as docker bind-mount sources).
# STORE_ROOT is the tenant store root (blobs/ + manifests/ + exports/).
# Blobs are persistent — they do NOT live in STAGING_ROOT (job temp only).
STORE_ROOT=./data/store
STAGING_ROOT=./data/staging

# Host paths for docker compose. Prefer ONE data disk:
#   DATA_ROOT=/mnt/raid/m365
# → $DATA_ROOT/store (blobs), $DATA_ROOT/staging (job temp), $DATA_ROOT/mysql
#
# Do NOT set DATA_STORE_PATH=./data/store if the backup disk is elsewhere —
# blobs would fill the OS root. Leave DATA_STORE_PATH unset, or point it at the RAID.
# DATA_ROOT=/mnt/raid/m365
# DATA_STORE_PATH=/mnt/raid/m365/store
DATA_STAGING_PATH=./data/staging
MYSQL_DATA_PATH=./data/mysql

# 32-byte master key, base64-encoded. Generate with:
#   openssl rand -base64 32
MASTER_KEY=

# Admin UI login (min 8 characters; 12+ recommended).
# API access uses Bearer tokens created under Settings, not this password.
ADMIN_USER=m365adminuser
ADMIN_PASSWORD=

# Max parallel backup jobs across all tenants. Per tenant only one job can be
# active at a time (tenant lock) — this limit is for multi-tenant hosts.
# Max parallel jobs across all tenants. Per tenant+service always ≤1.
MAX_CONCURRENT_JOBS=2
# Max parallel full Graph syncs (empty-store fan-out queues all services; only this many run).
MAX_CONCURRENT_FULL_JOBS=1
# Parallel Exchange/OneDrive mailboxes or drives within one job.
EXCHANGE_WORKERS=3
# Kill running jobs with no byte/item/progress change for this long (0 = off).
JOB_STALL_TIMEOUT=2h

# Optional default SMTP (can also be configured in the UI)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=m365backup@example.com
# SMTP_TO=ops@example.com
